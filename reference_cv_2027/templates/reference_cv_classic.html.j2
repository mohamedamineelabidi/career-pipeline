<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="document-status" content="candidate_pending_user_approval">
<title>{{ profile.identity.name }} | Classic Reference CV Candidate</title>
<style>
@page{size:A4;margin:0}
*{box-sizing:border-box}
:root{--blue:#254f73;--ink:#202830;--muted:#616a73;--line:#254f73;--soft:#d9e0e6}
html,body{width:210mm;height:297mm;margin:0;background:#fff}
body{font-family:Arial,"Segoe UI",sans-serif;color:var(--ink);font-size:9.15pt;line-height:1.34;-webkit-print-color-adjust:exact;print-color-adjust:exact}
a{color:inherit;text-decoration:none}
.page{width:210mm;height:297mm;padding:8.5mm 12.5mm 7.5mm;overflow:hidden;background:#fff}
header{text-align:center;padding-bottom:2.1mm;border-bottom:.45mm solid var(--blue)}
.name{font-family:Arial,"Segoe UI",sans-serif;font-size:18.8pt;line-height:1.05;letter-spacing:.3px;font-weight:700;text-transform:uppercase;margin:0;color:#202830}
.title{font-family:Arial,"Segoe UI",sans-serif;font-size:10.3pt;color:var(--blue);margin-top:.8mm;font-weight:600}
.contact{display:flex;justify-content:center;flex-wrap:wrap;gap:.55mm 3.3mm;margin-top:1.25mm;color:var(--muted);font-size:8.65pt}
.summary{text-align:center;padding:2mm 5mm 1.7mm;color:#344252;font-size:9pt}
.summary b{color:var(--blue)}
h2{font-family:Arial,"Segoe UI",sans-serif;font-size:9.8pt;line-height:1;text-transform:uppercase;letter-spacing:.4px;color:var(--blue);margin:2.2mm 0 1mm;padding:0 0 .5mm;border-bottom:.48mm solid var(--line);font-weight:700}
.entry{margin-bottom:1.55mm;break-inside:avoid}
.entry-head{display:flex;justify-content:space-between;gap:4mm;align-items:baseline}
.role{font-family:Arial,"Segoe UI",sans-serif;font-size:9.2pt;font-weight:700;color:#202830}
.date{font-family:Arial,"Segoe UI",sans-serif;font-size:8.7pt;font-weight:700;color:var(--blue);white-space:nowrap;text-transform:uppercase}
.orgline{display:flex;justify-content:space-between;gap:4mm;align-items:baseline;margin:.1mm 0 .3mm}
.org{font-size:8.7pt;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.1px}
.location{font-size:8.65pt;color:var(--muted);white-space:nowrap;font-style:italic}
ul{margin:.15mm 0 0;padding-left:4mm}
li{margin:.18mm 0;padding-left:.25mm;color:#303b48}
.tech{font-size:8.65pt;color:#4e5b69;margin-top:.25mm;font-style:italic}
.tech b{font-style:normal;color:var(--blue);font-weight:700}
.project .role{font-size:9pt}
.edu-row,.meta-row{font-size:8.65pt;margin:.22mm 0;color:#34404d}
.edu-row b,.meta-row b{font-family:Arial,"Segoe UI",sans-serif;color:#202830}
</style>
</head>
<body>
<main class="page">
  <header>
    <h1 class="name">{{ profile.identity.name }}</h1>
    <div class="title">{{ profile.targets.primary_identity }}</div>
    <div class="contact">
      <span>{{ profile.identity.location }}</span>
      <a href="mailto:{{ profile.identity.email }}">{{ profile.identity.email }}</a>
      <a href="tel:{{ profile.identity.phone | replace(' ', '') }}">{{ profile.identity.phone }}</a>
      <a href="{{ profile.identity.linkedin_url }}">linkedin.com/in/{{ profile.identity.linkedin_handle }}</a>
      <a href="{{ profile.identity.github_url }}">github.com/{{ profile.identity.github_handle }}</a>
      <a href="{{ profile.identity.portfolio_url }}">Portfolio</a>
    </div>
  </header>

  <div class="summary"><b>{{ profile.summary_evidence[0] }}</b> {{ profile.summary_evidence[1] }} Available for a PFE internship from <b>{{ profile.targets.pfe_available_from | format_date }}</b>.</div>

  <section>
    <h2>Professional Experience</h2>
    {% for item in experience %}
    <article class="entry">
      <div class="entry-head"><div class="role">{{ item.title }}</div><div class="date">{{ item.start_date | date_range(item.end_date) }}</div></div>
      <div class="orgline"><div class="org">{{ item.company }}{% if item.product %} · {{ item.product }}{% endif %}</div><div class="location">{{ item.location }}</div></div>
      <ul>{% for bullet in item.bullets %}<li>{{ bullet.statement }}</li>{% endfor %}</ul>
      <div class="tech"><b>Skills &amp; technologies:</b> {{ item.display_technologies | join(', ') }}</div>
    </article>
    {% endfor %}
  </section>

  <section>
    <h2>Projects</h2>
    {% for item in projects %}
    <article class="entry project">
      <div class="entry-head"><div class="role">{% if item.github_url %}<a href="{{ item.github_url }}" aria-label="View {{ item.name }} on GitHub">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %} · {{ item.role }}</div>{% if item.start_date %}<div class="date">{{ item.start_date | date_range(item.end_date) }}</div>{% endif %}</div>
      <ul>{% for bullet in item.bullets %}<li>{{ bullet.statement }}</li>{% endfor %}</ul>
      <div class="tech"><b>Technologies:</b> {{ item.display_technologies | join(', ') }}</div>
    </article>
    {% endfor %}
  </section>

  <section>
    <h2>Education</h2>
    {% for item in profile.education %}<div class="edu-row"><b>{{ item.institution }}</b> · {{ item.degree }}, {{ item.field }} <span style="float:right">{{ item.start_date | date_range(item.end_date) }}</span></div>{% endfor %}
  </section>

  <section>
    <h2>Leadership &amp; Certifications</h2>
    {% for item in profile.leadership %}<div class="meta-row"><b>{{ item.title }}, {{ item.organization }}:</b> {{ item.statement }}</div>{% endfor %}
    <div class="meta-row"><b>Certifications:</b> {% for item in profile.certifications %}{{ item.name }}{% if item.detail and 'pending' not in item.detail %} ({{ item.detail }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>
    <div class="meta-row"><b>Languages:</b> {% for item in profile.languages %}{{ item.name }} ({{ item.level }}){% if not loop.last %} · {% endif %}{% endfor %}</div>
  </section>
</main>
</body>
</html>
