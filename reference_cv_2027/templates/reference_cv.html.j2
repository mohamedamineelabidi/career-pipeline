<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="document-status" content="candidate_pending_user_approval">
<title>{{ profile.identity.name }} | Reference CV Candidate</title>
<style>
@page{size:A4;margin:0}
*{box-sizing:border-box}
:root{--ink:#142033;--muted:#566273;--navy:#183a63;--line:#d8dfe7}
html,body{width:210mm;height:297mm;margin:0;background:#fff}
body{font-family:"Segoe UI",Arial,sans-serif;color:var(--ink);font-size:8.65pt;line-height:1.28;-webkit-print-color-adjust:exact;print-color-adjust:exact}
a{color:inherit;text-decoration:none}
.page{width:210mm;height:297mm;padding:7.5mm 11mm 6.5mm;overflow:hidden;background:#fff}
header{display:grid;grid-template-columns:1fr 22mm;gap:5mm;align-items:center;border-bottom:.45mm solid var(--navy);padding-bottom:2.2mm}
.name{font-size:20.5pt;line-height:1;font-weight:760;letter-spacing:-.45px;margin:0;color:#101a2a}
.title{font-size:10pt;font-weight:700;color:var(--navy);margin-top:1mm}
.contact{display:flex;flex-wrap:wrap;gap:.55mm 3mm;margin-top:1.3mm;color:#4e5a6b;font-size:8.5pt}
.contact a,.contact span{white-space:nowrap}
.photo{width:22mm;height:22mm;border-radius:50%;object-fit:cover;object-position:center top;border:.35mm solid #ccd4de}
.summary{padding:2mm 0 1.8mm;border-bottom:.22mm solid var(--line);color:#334054}
.summary b{color:var(--ink)}
h2{font-size:8.8pt;text-transform:uppercase;letter-spacing:.85px;color:var(--navy);margin:2.1mm 0 .9mm;padding-bottom:.45mm;border-bottom:.25mm solid var(--line);font-weight:760}
.entry{margin-bottom:1.45mm;break-inside:avoid}
.entry-head{display:flex;justify-content:space-between;gap:3mm;align-items:baseline}
.role{font-size:8.8pt;font-weight:760;color:#142033}
.date{font-size:8.5pt;font-weight:620;color:#536071;white-space:nowrap}
.org{color:var(--navy);font-weight:680;margin:.15mm 0 .3mm}
ul{list-style:none;margin:0;padding:0}
li{position:relative;padding-left:2.5mm;margin:.25mm 0;color:#354154}
li:before{content:"";position:absolute;left:.15mm;top:.56em;width:.9mm;height:.25mm;background:var(--navy)}
.tech{font-size:8.5pt;color:#4c596b;margin-top:.35mm}
.tech b{color:#24354b;font-weight:720}
.project-grid{display:grid;grid-template-columns:1fr;gap:.25mm}
.project .entry-head{margin-bottom:.1mm}
.skills{display:block}
.skill-line{font-size:8.5pt;color:#354154;margin:.25mm 0}
.skill-line b{color:#18243a}
.edu-row,.meta-row{font-size:8.5pt;margin:.25mm 0;color:#354154}
.edu-row b,.meta-row b{color:#18243a}

</style>
</head>
<body>
<main class="page">
  <header>
    <div>
      <h1 class="name">{{ profile.identity.name }}</h1>
      <div class="title">{{ profile.targets.headline }}</div>
      <div class="contact">
        <span>{{ profile.identity.location }}</span>
        <a href="tel:{{ profile.identity.phone | replace(' ', '') }}">{{ profile.identity.phone }}</a>
        <a href="mailto:{{ profile.identity.email }}">{{ profile.identity.email }}</a>
        <a href="{{ profile.identity.linkedin_url }}">linkedin.com/in/{{ profile.identity.linkedin_handle }}</a>
        <a href="{{ profile.identity.github_url }}">github.com/{{ profile.identity.github_handle }}</a>
        <a href="{{ profile.identity.portfolio_url }}">Portfolio</a>
      </div>
    </div>
    <img class="photo" src="{{ photo_src }}" alt="{{ profile.identity.name }}">
  </header>

  <div class="summary"><b>{{ profile.summary_evidence[0] }}</b> {{ profile.summary_evidence[1] }} Available for a PFE internship from <b>{{ profile.targets.pfe_available_from | format_date }}</b>.</div>

  <section>
    <h2>Professional Experience</h2>
    {% for item in experience %}
    <article class="entry">
      <div class="entry-head"><div class="role">{{ item.title }}</div><div class="date">{{ item.start_date | date_range(item.end_date) }}</div></div>
      <div class="org">{{ item.company }}{% if item.product %} · {{ item.product }}{% endif %} | {{ item.location }}</div>
      <ul>{% for bullet in item.bullets %}<li>{{ bullet.statement }}</li>{% endfor %}</ul>
      <div class="tech"><b>Skills &amp; technologies:</b> {{ item.display_technologies | join(', ') }}</div>
    </article>
    {% endfor %}
  </section>

  <section>
    <h2>Selected Projects</h2>
    <div class="project-grid">
    {% for item in projects %}
    <article class="entry project">
      <div class="entry-head"><div class="role">{% if item.github_url %}<a href="{{ item.github_url }}" aria-label="View {{ item.name }} on GitHub">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %} | {{ item.role }}</div>{% if item.start_date %}<div class="date">{{ item.start_date | date_range(item.end_date) }}</div>{% endif %}</div>
        <ul>{% for bullet in item.bullets %}<li>{{ bullet.statement }}</li>{% endfor %}</ul>
        <div class="tech"><b>Technologies:</b> {{ item.display_technologies | join(', ') }}</div>
      </article>
    {% endfor %}
    </div>
  </section>


  <section>
    <h2>Education, Leadership &amp; Credentials</h2>
    {% for item in profile.education %}<div class="edu-row"><b>{{ item.degree }}, {{ item.field }}</b> | {{ item.institution }} | {{ item.start_date | date_range(item.end_date) }}</div>{% endfor %}
    {% for item in profile.leadership %}<div class="meta-row"><b>{{ item.title }}, {{ item.organization }}:</b> {{ item.statement }}</div>{% endfor %}
    <div class="meta-row"><b>Certifications:</b> {% for item in profile.certifications %}{{ item.name }}{% if item.detail and 'pending' not in item.detail %} ({{ item.detail }}){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</div>
    <div class="meta-row"><b>Languages:</b> {% for item in profile.languages %}{{ item.name }} ({{ item.level }}){% if not loop.last %}, {% endif %}{% endfor %}</div>
  </section>
</main>
</body>
</html>
