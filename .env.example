# Copy to .env and fill in. .env is gitignored and must never be committed.

# Optional: enables the LLM second-opinion fit score.
# Without these the pipeline uses local sentence-transformer scoring only.
# Any OpenAI-compatible endpoint works (Groq, OpenAI, local llama.cpp server...).
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
